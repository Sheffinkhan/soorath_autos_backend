# Copy this file to Backend/.env on the server and fill in real values.
# Never commit the real .env file.

SECRET_KEY=change-me
DEBUG=False

# Comma-separated lists. If one is left out, settings.py uses its built-in list.
ALLOWED_HOSTS=your-domain.example.com
CORS_ALLOWED_ORIGINS=https://prod.d3q88yk7ov76i2.amplifyapp.com
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

DB_NAME=soorathautos
DB_USER=soorathuser
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Image storage. These defaults are for AWS S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Cloudflare R2 only. Also set AWS_REGION=auto and use R2 keys above.
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=images.your-domain.example.com
